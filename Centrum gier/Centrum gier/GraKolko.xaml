<UserControl x:Class="Centrum_gier.GraKolko"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtStatus" Text="Ruch gracza: X" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#212529"/>

        <UniformGrid Grid.Row="1" Rows="3" Columns="3" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="B00" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B01" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B02" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B10" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B11" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B12" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B20" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B21" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
            <Button x:Name="B22" FontSize="36" FontWeight="Bold" Click="Button_Click"/>
        </UniformGrid>

        <Button Grid.Row="2" Content="Resetuj grę" Width="120" Padding="8" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" Click="BtnReset_Click"/>
    </Grid>
</UserControl>
